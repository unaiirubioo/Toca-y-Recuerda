# =====================================================================
# Toca y Recuerda — .env.example
# Copia este archivo como .env.local y rellena tus propias claves.
# NUNCA subas .env.local al repositorio (ya está en .gitignore).
# =====================================================================

# --- Supabase ---
# Panel de tu proyecto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
# service_role: solo se usa en el servidor (Server Actions / Route Handlers). NUNCA la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# --- Stripe ---
# Panel de Stripe > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Panel de Stripe > Developers > Webhooks (se genera al crear el endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Aplicación ---
NEXT_PUBLIC_SITE_URL=https://tocayrecuerda.com
NEXT_PUBLIC_SITE_NAME="Toca y Recuerda"
# En local, usa http://localhost:3000

# --- Seguridad ---
# Cadena aleatoria larga (genera una con `openssl rand -hex 32`).
# Firma el "pase de acceso" a álbumes privados con contraseña.
ALBUM_ACCESS_SECRET=

# --- Email (arquitectura preparada, spec #55; opcional en Fase 1) ---
# Ejemplo con Resend — se activará en una fase posterior.
RESEND_API_KEY=
EMAIL_FROM="Toca y Recuerda <hola@tocayrecuerda.com>"
